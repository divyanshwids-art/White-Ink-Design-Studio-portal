# Database (PostgreSQL / Supabase / Neon / Railway / Cloud SQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planforge?schema=public"

# Authentication (REQUIRED)
# In production, JWT_SECRET must be set to a cryptographically strong, high-entropy random string (e.g. openssl rand -base64 32). The server refuses to start if missing or empty.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3000
NODE_ENV="development"

# CORS Multi-Frontend Allowed Origins (Comma-separated or individual variables)
FRONTEND_URL=""
CLIENT_PORTAL_URL="http://localhost:3001"
TEAM_PORTAL_URL="http://localhost:3002"
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3002"

# FRONTEND FIREBASE ENVIRONMENT VARIABLES (Public Web Client Configuration)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""

# BACKEND FIREBASE ADMIN ENVIRONMENT VARIABLES (Private Server Secrets - Do NOT expose to client)
# Handled with escaped newline characters (\n) if provided as single-line string
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# GOOGLE INTEGRATION FOUNDATION (Super Admin Singleton Account)
# ==============================================================================
# Obtained from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs):
# Application type: Web application
# Authorized redirect URI: http://localhost:3000/api/google/callback (in dev) or https://your-domain.com/api/google/callback (in prod)

# Google Cloud OAuth 2.0 Client ID (Public / Server Identifier)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Google Cloud OAuth 2.0 Client Secret (SECRET - Keep strictly confidential)
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google OAuth 2.0 Redirect URI (Must match an Authorized Redirect URI in Google Cloud Console)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Secret Encryption Key for AES-256-GCM token encryption at rest (SECRET - Keep strictly confidential)
# Must be exactly 32 bytes (64 hex characters or 44 base64 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY="your-32-byte-hex-or-base64-encryption-key"
